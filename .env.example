# The exact public domain that points to this EC2 instance's Elastic IP.
DOMAIN=domain.com

# Generate once. Keep it unchanged after users have signed in, or stored Drive
# tokens can no longer be decrypted.
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=TOKEN_ENCRYPTION_KEY
GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET
GOOGLE_PICKER_API_KEY=GOOGLE_PICKER_API_KEY
GOOGLE_REDIRECT_URI=https:/domain.com/auth/google/callback

# Generate a strong random value, for example: openssl rand -hex 32
SESSION_SECRET=SESSION_SECRET
DATABASE_PATH=/data/db.sqlite3
DEMO_MODE=false
COOKIE_SECURE=false